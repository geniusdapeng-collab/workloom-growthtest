{
  "description": "P0 SessionStart 只读摘要；无写工具或审计写入 hook",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/hook-session-start.sh\"",
            "timeout": 20,
            "statusMessage": "加载 WorkLoom 能力上下文",
            "additionalContextLimit": 1500
          }
        ]
      }
    ]
  }
}
