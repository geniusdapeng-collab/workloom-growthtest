{
  "schemaVersion": "workloom.acceptance-profile/v2",
  "repo": "workloom-ai/WorkLoom-growthtest",
  "productName": "WorkLoom 获客增长系统（实验车道）",
  "lane": "industry",
  "primaryBundle": "geo-growthtest",
  "workspaceId": null,
  "dataMode": "simulated",
  "identity": {
    "workspaceSlug": "geo-growthtest",
    "human": "MEM-G01",
    "guest": "demo-direct"
  },
  "startup": {
    "command": "pnpm preview:all",
    "ports": {
      "pc": 3000,
      "bMobile": 3001,
      "cMobile": 3002,
      "server": 8787
    }
  },
  "surfaces": {
    "pcRoutes": [
      "/",
      "/inbox",
      "/tasks",
      "/reports",
      "/service",
      "/executive",
      "/guardrails",
      "/exams",
      "/memory",
      "/night",
      "/skills",
      "/members",
      "/partners",
      "/account",
      "/workspaces",
      "/customize",
      "/configuration",
      "/assembly",
      "/agents",
      "/portfolio",
      "/events",
      "/models",
      "/onboarding"
    ],
    "bMobileRoutes": [
      "/",
      "/inbox",
      "/tasks",
      "/operations",
      "/account"
    ],
    "cRoutes": [
      "#chat",
      "#service",
      "#tickets",
      "#messages",
      "#me"
    ]
  },
  "thresholds": {
    "firstValueMs": 20000,
    "dispatchMs": 60000,
    "approvalMs": 30000,
    "traceClicks": 2,
    "guestFirstReplyMs": 30000,
    "decisionQuota": 7,
    "minContrastRatio": 4.5,
    "idleInterruptionWindowS": 20
  },
  "ux": {
    "personas": [],
    "journeys": [],
    "tasks": [],
    "research": {
      "participants": [],
      "methods": [
        "think-aloud",
        "first-click",
        "five-second"
      ],
      "instruments": [
        "SUS",
        "SEQ"
      ]
    }
  },
  "outcome": {
    "roles": [],
    "taskSuites": [],
    "receipts": []
  },
  "autonomy": {
    "interventionTaxonomy": "H0-H4",
    "fixtureFilters": [
      "suite.",
      "suite-",
      "apr-suite-",
      "apr-e-",
      "T-suite"
    ],
    "windows": [
      "4w"
    ],
    "targetPrecisionPp": 10,
    "offlineAuditSample": 10
  },
  "soak": {
    "hours": [
      24,
      168,
      672
    ],
    "metrics": [
      "success",
      "latency",
      "cost",
      "drift"
    ]
  },
  "journeys": [],
  "notes": "由 fleet-run.mjs 依据 product.manifest.json 生成：角色/旅程/阈值请本仓负责人在首轮验收后按行业细化。",
  "environment": {
    "kind": "client-runtime",
    "allowWrites": true,
    "supportDir": null,
    "target": {
      "apiUrl": "http://127.0.0.1:9207",
      "pcUrl": "http://127.0.0.1:5593",
      "bMobileUrl": null,
      "cMobileUrl": null
    },
    "notes": "本仓桌面客户端按 product.manifest.json#desktop.portOffset=420 偏移端口：server 8787+420=9207、web 5173+420=5593、PG 5432+420=5852；生产实测用 --env client-runtime。"
  },
  "live": {
    "enabled": true,
    "requireRealModels": false,
    "allowDb": false,
    "budgets": {
      "maxLlmCalls": 40,
      "maxLlmTokens": 300000,
      "maxImages": 8,
      "maxVideoClips": 3,
      "minVideoSeconds": 10,
      "maxVideoSeconds": 15,
      "maxVideoSecondsTotal": 45,
      "maxCostCny": 120,
      "maxWallClockMin": 45
    },
    "models": [
      {
        "id": "deepseek-v4.1-flash",
        "kind": "llm",
        "model": "deepseek-flash",
        "adapter": "dsh-harness",
        "apiKeyEnv": "DEEPSEEK_API_KEY",
        "baseUrlEnv": "DEEPSEEK_BASE_URL"
      },
      {
        "id": "seedream-5.0",
        "kind": "image",
        "model": "doubao-seedream-5-0-pro-260628",
        "adapter": "gen-http",
        "apiKeyEnv": "VOLCENGINE_ARK_API_KEY",
        "baseUrlEnv": "SEEDREAM_ENDPOINT"
      },
      {
        "id": "seedance-2.5",
        "kind": "video",
        "model": "doubao-seedance-2-5-260628",
        "adapter": "gen-http",
        "apiKeyEnv": "VOLCENGINE_ARK_API_KEY",
        "baseUrlEnv": "SEEDANCE_ENDPOINT"
      }
    ],
    "tasks": [
      {
        "id": "LLM-R1",
        "kind": "llm",
        "chain": "dsh-harness",
        "model": "deepseek-v4.1-flash",
        "criticality": "P0",
        "title": "内置模型 · 获客策略推理（dsh harness + 围栏 + 账本）",
        "prompt": "背景：一家社区手冲咖啡馆，开业 3 个月，日均 60 杯，客单价 28 元，线上几乎零曝光，预算每月 3000 元。请给出：① 优先做的两个获客动作与理由 ② 一个 7 天可执行的发布节奏 ③ 最大的风险。要求：先结论后依据，最后另起一行输出 TASK_COMPLETE。",
        "expect": [
          "获客|曝光|内容|团购|核销|复购|毛利|风险|预算"
        ],
        "expectAll": [
          "TASK_COMPLETE"
        ]
      },
      {
        "id": "LLM-T1",
        "kind": "llm",
        "chain": "dsh-harness",
        "model": "deepseek-v4.1-flash",
        "criticality": "P0",
        "title": "内置模型 · 工具循环（工具调用过围栏瀑布 + 事件落账）",
        "prompt": "请调用 bash 工具执行 `echo workloom-geo-live`，把命令输出原样贴出来，然后另起一行输出 TASK_COMPLETE。",
        "expect": [
          "workloom-geo-live|TASK_COMPLETE"
        ],
        "expectAll": [
          "TASK_COMPLETE"
        ]
      },
      {
        "id": "LLM-M1",
        "kind": "llm",
        "chain": "dsh-harness",
        "model": "deepseek-v4.1-flash",
        "criticality": "P1",
        "fixture": "auto",
        "title": "内置模型 · 多模态理解（图片到达模型）",
        "prompt": "请打开随附图片，用一句话说明图中主体内容，并原样念出图中徽标里的那串字符。最后另起一行输出 TASK_COMPLETE。",
        "expect": [
          "WORKLOOM|验收|夹具"
        ],
        "expectAll": [
          "TASK_COMPLETE"
        ]
      },
      {
        "id": "LLM-G1",
        "kind": "llm",
        "chain": "model-gateway",
        "model": "deepseek-v4.1-flash",
        "criticality": "P1",
        "title": "模型网关 · 结构化输出",
        "prompt": "只输出一行 JSON：{\"verdict\":\"ok\",\"risk\":\"low\",\"reason\":\"<20 字内>\"}。不要输出任何其他内容。",
        "expect": [
          "verdict"
        ]
      },
      {
        "id": "IMG-01",
        "kind": "image",
        "model": "seedream-5.0",
        "criticality": "P1",
        "images": 2,
        "title": "生图 · 手冲咖啡馆主视觉（2 张）",
        "prompt": "手冲咖啡馆主视觉：木质吧台上白色陶瓷手冲杯与细口手冲壶，热水细流注入咖啡粉，粉层微微鼓起，蒸汽轻扬；暖色侧逆光，浅景深，背景虚化的咖啡馆窗景与绿植；胶片质感；构图留出上下文字区；无人物、无文字、无 logo。",
        "expect": [
          "png"
        ],
        "minArtifacts": 1
      },
      {
        "id": "IMG-02",
        "kind": "image",
        "model": "seedream-5.0",
        "criticality": "P2",
        "images": 1,
        "title": "生图 · 获客素材（朋友圈方图）",
        "prompt": "方形获客素材：一杯拉花拿铁的俯拍，深色木桌、杂志与咖啡豆点缀，暖色调，留出右侧文字留白，无人物、无文字。",
        "expect": [
          "png"
        ],
        "minArtifacts": 1
      },
      {
        "id": "VID-01",
        "kind": "video",
        "model": "seedance-2.5",
        "criticality": "P1",
        "durationSeconds": 12,
        "title": "生视频 · 12s 门店短视频镜头",
        "prompt": "清晨的手冲咖啡馆：镜头从吧台左侧缓慢横移到手冲壶注水的特写，蒸汽升腾，暖色灯光，画面干净，无人物，无文字。",
        "expect": [
          "mp4"
        ],
        "durationRange": [
          10,
          15
        ]
      },
      {
        "id": "PROD-01",
        "kind": "product",
        "criticality": "P0",
        "title": "产品派单链路 · 经客户端入口派单 + 状态断言",
        "input": "给手冲咖啡馆做一份 7 天获客计划（交付物：动作清单 + 每天一条内容主题，截止：今天 18:00）",
        "presetKey": "company-ceo",
        "workspaceSlug": "geo-growthtest",
        "state_asserts": [
          {
            "http": {
              "url": "http://127.0.0.1:9207/health",
              "status": 200
            }
          }
        ]
      }
    ],
    "notes": "P 域生产实测（本仓口径）：LLM 走 dsh harness（含围栏瀑布 + 哈希链账本）；生图/生视频走火山方舟（seedream-5.0-pro / seedance-2.5）；产品派单走本机客户端 9207。配额：图 ≤8、视频 ≤3 段且各 10–15s、总 ≤45s、LLM ≤40 次/¥120。"
  }
}
