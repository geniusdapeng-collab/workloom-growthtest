    "tasks": [
      {
        "id": "LLM-R1",
        "kind": "llm",
        "chain": "dsh-harness",
        "model": "deepseek-v4.1-flash",
        "criticality": "P0",
        "title": "内置模型 · 获客策略推理（dsh harness + 围栏 + 账本）",
        "prompt": "背景：一家社区手冲咖啡馆，开业 3 个月，日均 60 杯，客单价 28 元，线上几乎零曝光，预算每月 3000 元。请给出：① 优先做的两个获客动作与理由 ② 一个 7 天可执行的发布节奏 ③ 最大的风险。要求：先结论后依据，最后另起一行输出 TASK_COMPLETE。",
        "expect": [
          "获客|曝光|内容|团购|核销|复购|毛利|风险|预算"
        ],
        "expectAll": [
          "TASK_COMPLETE"
        ]
      },
      {
        "id": "LLM-T1",
        "kind": "llm",
        "chain": "dsh-harness",
        "model": "deepseek-v4.1-flash",
        "criticality": "P0",
        "title": "内置模型 · 工具循环（工具调用过围栏瀑布 + 事件落账）",
        "prompt": "请调用 bash 工具执行 `echo workloom-geo-live`，把命令输出原样贴出来，然后另起一行输出 TASK_COMPLETE。",
        "expect": [
          "workloom-geo-live|TASK_COMPLETE"
        ],
        "expectAll": [
          "TASK_COMPLETE"
        ]
      },
      {
        "id": "LLM-M1",
        "kind": "llm",
        "chain": "dsh-harness",
        "model": "deepseek-v4.1-flash",
        "criticality": "P1",
        "fixture": "auto",
        "title": "内置模型 · 多模态理解（图片到达模型）",
        "prompt": "请打开随附图片，用一句话说明图中主体内容，并原样念出图中徽标里的那串字符。最后另起一行输出 TASK_COMPLETE。",
        "expect": [
          "WORKLOOM|验收|夹具"
        ],
        "expectAll": [
          "TASK_COMPLETE"
        ]
      },
      {
        "id": "LLM-G1",
        "kind": "llm",
        "chain": "model-gateway",
        "model": "deepseek-v4.1-flash-gateway",
        "criticality": "P1",
        "title": "模型网关 · 结构化输出",
        "prompt": "只输出一行 JSON：{\"verdict\":\"ok\",\"risk\":\"low\",\"reason\":\"<20 字内>\"}。不要输出任何其他内容。",
        "expect": [
          "verdict"
        ]
      },
      {
        "id": "IMG-01",
        "kind": "image",
        "model": "seedream-5.0",
        "criticality": "P1",
        "images": 2,
        "title": "生图 · 手冲咖啡馆主视觉（2 张）",
        "prompt": "手冲咖啡馆主视觉：木质吧台上白色陶瓷手冲杯与细口手冲壶，热水细流注入咖啡粉，粉层微微鼓起，蒸汽轻扬；暖色侧逆光，浅景深，背景虚化的咖啡馆窗景与绿植；胶片质感；构图留出上下文字区；无人物、无文字、无 logo。",
        "expect": [
          "png"
        ],
        "minArtifacts": 1
      },
      {
        "id": "IMG-02",
        "kind": "image",
        "model": "seedream-5.0",
        "criticality": "P2",
        "images": 1,
        "title": "生图 · 获客素材（朋友圈方图）",
        "prompt": "方形获客素材：一杯拉花拿铁的俯拍，深色木桌、杂志与咖啡豆点缀，暖色调，留出右侧文字留白，无人物、无文字。",
        "expect": [
          "png"
        ],
        "minArtifacts": 1
      },
      {
        "id": "VID-01",
        "kind": "video",
        "model": "seedance-2.5",
        "criticality": "P1",
        "durationSeconds": 12,
        "title": "生视频 · 12s 门店短视频镜头",
        "prompt": "清晨的手冲咖啡馆：镜头从吧台左侧缓慢横移到手冲壶注水的特写，蒸汽升腾，暖色灯光，画面干净，无人物，无文字。",
        "expect": [
          "mp4"
        ],
        "durationRange": [
          10,
          15
        ]
      },
      {
        "id": "PROD-01",
        "kind": "product",
        "criticality": "P0",
        "title": "隔离社媒指标核查（经产品入口与线程事件读回）",
        "input": "suite.rdas.workloom-growthtest：当前隔离实验中的社媒播放、涨粉、互动、询盘四项指标如何核查基线和工具回执？请用“社媒”标注未核实数字与异常线索，只回答检查清单，不处置告警或改动投放。",
        "presetKey": "data-board-officer",
        "workspaceSlug": "geo-growth",
        "requireModel": true,
        "fixtureMarker": "suite.rdas.workloom-growthtest",
        "residualDisclosure": "隔离社媒指标核查验收会保留带 suite.rdas.workloom-growthtest 标记的线程和事件；不会删除审计事件，需单独列入残留清单并排除 ADR/HIR 与经营指标。",
        "state_asserts": [
          {
            "event": {
              "action": "ask.answer",
              "field": "decision.after.text",
              "contains": "社媒",
              "minLength": 12
            }
          }
        ]
      }
    ],
    "notes": "local-preview 不执行 P 域生产实测；P0-P3 保持未验证。"
