{
  "schemaVersion": "workloom.style-variant/v1",
  "id": "clean-tech",
  "name": "标准版",
  "positioning": "产品/科技/知识：冷净调、硬切、信息优先文案",
  "colorPolicy": "grade",
  "platforms": [
    "抖音/快手",
    "视频号",
    "B站",
    "官网"
  ],
  "color": {
    "profile": "cool-technical",
    "intensity": 0.28,
    "lookLabel": "轻冷净",
    "note": "2026-10-18 收敛：保留轻微冷净色温与克制对比，去掉第二层 LUT，避免与 1080P 成片后的字幕/弹幕编码叠加成明显处理感。"
  },
  "transitions": {
    "mode": "hard",
    "fadeSec": 0,
    "note": "硬切不打断信息密度；卖点与数据段不加入场动画（整段口径；有逐切计划时按 intentMap 逐刀执行）",
    "scale": 0.85,
    "intentMap": {
      "dissolve": { "type": "fade", "durationSec": 0.35 },
      "fade_from_black": { "type": "fadeblack", "durationSec": 0.45 },
      "fade_to_black": { "type": "fadeblack", "durationSec": 0.45 },
      "wipe": { "type": "wipeleft", "durationSec": 0.3 },
      "whip_pan": { "type": "smoothleft", "durationSec": 0.28 },
      "zoom_blur": { "type": "zoomin", "durationSec": 0.3 }
    },
    "intentNote": "标准版：短促、方向明确；擦除优先硬边 wipeleft，避免情绪化的慢叠化"
  },
  "bgm": {
    "mood": "干净可信",
    "style": "corporate-clean",
    "policy": "keep-dialogue",
    "musicLevelDb": -25,
    "targetLufs": -14,
    "fadeInSec": 0.8,
    "fadeOutSec": 1.0,
    "section": "auto",
    "note": "极简律动；人声是主角，音乐只做底噪衔接"
  },
  "cover": {
    "template": "参数卡",
    "at": 0.6,
    "alignment": 8,
    "marginRatio": 0.07,
    "note": "上方压标题 + 参数式钩子；下方留出平台 UI 安全区"
  },
  "copy": {
    "tone": "简洁理性",
    "titleTemplate": "{title}｜{hook}",
    "opening": "三个数据先说结论。",
    "closing": "细节写在评论区置顶，需要的自取。",
    "cta": "还有想看的参数，评论区点名",
    "hashtags": ["#科技数码", "#产品实测", "#硬核科普"]
  },
  "subtitleStyle": {
    "scene": "字幕",
    "note": "中性无衬线、细描边；数字与单位不拆行"
  }
}
