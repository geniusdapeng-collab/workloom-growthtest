    "outline_ratio": 0.06,
    "safe_margin_ratio": 0.05,
    "弹幕规则": "从右向左滚动或顶部固定，单条不超过 20 字，透明度 85%",
    "贴纸规则": "配合出现动画（弹入/淡入 200ms），停留 1.5~3s"
  },
