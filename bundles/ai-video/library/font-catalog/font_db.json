  "source": "font-library-v1.1（29 款开源/免费商用字体，来自随包 font_db.json v1.1 打标档）",
  "principle": "场景 + 语言先硬过滤，再按 作品类型30 / BGM节奏20 / 粗细×场景20 / 艺术气息×调性15 / 气质关键词15 加权打分；账号调性的『锁定字体』是品牌视觉锤，优先于打分。字体文件不进仓库：工位按 connectors/subtitle-bridge/kit/fonts-pin.json 获取并逐文件 sha256 校验。",
  "licensePolicy": {
    "commercialWhitelist": [
      "ofl-1.1",
      "apache-2.0",
      "vendor-free-commercial"
    ],
    "note": "商用交付只允许白名单许可；单售字体文件被 OFL 禁止，修改后再发布必须改名。vendor-free-commercial 指厂商免费商用授权（如阿里妈妈/普惠体），登记时必须附许可证明链接。"
  },
  "size_policy": {
    "_comment": "字号策略：字号 = 短边 × base_ratio[场景] × 粗细修正(1+(2.5-粗细)*0.04)；再乘平台字号倍率(见 layout_policy)",
