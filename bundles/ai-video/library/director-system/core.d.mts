export type DirectorPlatform = "douyin" | "xiaohongshu" | "wechat-channels";
export type CreativeOrigin = "explicit" | "history" | "inferred" | "default";
export interface DirectorScope { tenantId: string; workspaceId: string; projectId: string; runId?: string; revision?: number }
export interface DeliveryTarget { variantId: string; platform: DirectorPlatform; platformLabel: string; recipeId: string; recipeVersion: string; label: string; kind: "regular" | "surprise"; origin: CreativeOrigin; recommended: boolean; recommendationReason?: string }
export interface DeliveryTargetPlan { schemaVersion: string; policyVersion: string; platforms: DirectorPlatform[]; regular: DeliveryTarget[]; surprise: DeliveryTarget | null; targets: DeliveryTarget[]; excluded: DirectorPlatform[]; styleReferences: DirectorPlatform[]; decisions: Array<Record<string, unknown>>; origin: CreativeOrigin; expectedOutputs: number; planHash: string }
export interface DirectorProfile { schemaVersion: string; intent: string; confirmationSteps: number; presentation: Record<string, unknown>; presentationOrigins: Record<string, CreativeOrigin>; defaults: Array<{ department: string; value: string; origin: CreativeOrigin; version: string }>; preferences: Array<Record<string, unknown>>; requiredInputs: string[]; creativeMode: "director_auto"; constraints: Record<string, unknown>; qualityTarget: string; profileHash: string }
