export interface SourceManifest { fps?: number; chronologyLocked?: boolean; shots: SourceShot[] }
export interface PictureEdit { sourceId: string; sourceSha256: string; inFrame: number; outFrame: number; startFrame: number; role: string; sourceIndex: number; segmentId: string; dialogueProtected: boolean; crop: string; transition: string }
export interface TimelineAdjustment extends Record<string, unknown> { shotIds?: string[]; factor: number; pace?: string }
export interface PostVariantPlan { schemaVersion: string; variantId: string; platform: DirectorPlatform; label: string; kind: string; recommended: boolean; recommendationReason: string; recipeId: string; recipeVersion: string; sourceManifestHash: string; targetPlanHash: string; scope: DirectorScope | Record<string, unknown>; fps: number; durationFrames: number; pictureEdl: PictureEdit[]; audioEdl: Array<Record<string, unknown>>; subtitlePlan: { style: Record<string, unknown>; mapFrom: string; preserveSentence: boolean; safeArea: string }; gradePlan: Record<string, unknown>; musicPlan: Record<string, unknown>; coverPlan: Record<string, unknown>; copyPlan: Record<string, unknown>; narrativePlan: string | Record<string, unknown>; differenceIntent: string; hardConstraints: Record<string, unknown>; parentRevision: number; variantIndex: number; planHash: string }
