  "prompt": {
    "scene": "T7 美妆时尚：场景即品位宣言——杂志感纯色空间/精品店氛围/整洁梳妆区/生活方式空间/干净街拍；宁空勿滥、宁可简不可俗；色调可为低饱和高级灰、莫兰迪或奶油调，但必须干净通透有明度层次。",
    "speech": "教程讲解、展示式或分享式；语气自信松弛有审美主张，专业术语（色号/质地/工艺）必须准确；禁止叫卖催单、夸大妆效与拉踩引战话术。",
    "visualReview": "逐镜检查：妆容/产品特写是否 ≥30% 且皮肤质感真实（保留纹理、磨皮感知度 ≤30%）；穿搭是否有全身+半身+细节三级镜头与动态呈现（行走/转身/回眸）；细节特写（面料/配饰/手法/美甲）是否齐备；中景人物气质与场景氛围是否成立；面部柔光是否均匀、有无眼神光。拒绝出租屋感、杂乱化妆台、廉价网红风堆砌、光线灾难（强黄光/顶光/彩色灯污染肤色/频闪）、过度滤镜（硅胶脸/假白/口红变色/柔光雾）与背景穿帮（晾衣架/外卖盒/垃圾桶/路人/凌乱床铺/镜面指纹）。",
    "byTag": {
      "makeup-close": "妆容特写：妆效质感与皮肤纹理真实，色号还原准确，柔光通透、有眼神光。",
      "full-look": "全身造型：整体比例与搭配逻辑清楚，服装熨烫平整、无褶皱穿帮。",
      "detail": "细节特写：面料/配饰/上妆手法微距干净，指甲与缝线经得起放大。",
      "medium": "中景人物：气质松弛自信，背景克制精致、不抢戏。"
    }
  }
