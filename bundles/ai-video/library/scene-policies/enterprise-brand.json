  "prompt": {
    "scene": "T2 企业品牌宣传片：画面回答「这家企业凭什么值得信任/合作/加入」——实力感、格局感与品质感；默认明亮、大气、通透，色彩干净统一并与品牌 VI 呼应；全片气质在厚重感与未来感两条路线中二选一，不混搭。",
    "speech": "旁白大气沉稳（播音级）或领导/员工访谈金句穿插；措辞克制有力、短句确定表达；数据必须真实可核实，禁止假大空排比与与画面不符的吹嘘。",
    "visualReview": "逐镜检查：开场是否有航拍/大全景定调；是否有纵深穿越、工艺/产品细节特写、有人气的团队镜头与升华收尾；建筑外观是否为黄金时刻或通透天气；室内灯光明亮有层次；产线/车间是否整洁有序、作业规范；全片色调、画质与运镜水准是否统一。拒绝陈旧破败空间、杂乱产线、监控画质感、空镜无人、穿帮（玩手机/打瞌睡/安全违规）与素材拼接感；拒绝廉价包装元素与不可核实数据。",
    "byTag": {
      "wide": "航拍或大全景定调：建筑/园区/城市天际线，黄金时刻或通透蓝天，企业规模与格局一眼可读。",
      "environment": "环境场景镜头交代实力主载体：挑高大堂/前厅、开放办公区、智能产线、研发实验室或品牌展厅，空间秩序与质感可辨。",
      "detail": "细节特写证明品质：工艺纹理、材质光泽与产品结构微距清晰，光线干净、经得起放大细看。",
      "people": "人文镜头必须有人气：团队协作或专注工作状态，动作自然、着装规范、无穿帮。"
    }
  }
