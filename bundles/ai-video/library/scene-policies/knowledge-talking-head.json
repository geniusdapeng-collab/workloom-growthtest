  "prompt": {
    "scene": "T6 知识口播：画面任务只有两件——不抢戏（注意力）与能背书（信任状）。背景干净统一、亮度低于人物（人物永远最亮），元素与讲述领域强相关；固定且有质感的场景形成人设记忆点。",
    "speech": "清晰优先、结构优先；口语化但有逻辑密度，信息点之间留气口并配合 B-roll 切换；允许网感表达，禁止夸张震惊体与无关热词。",
    "visualReview": "逐镜检查：主口播中近景是否占 50–60%、构图是否稳定均衡（胸部以上、头顶留白适度）；是否有 ≥2 个机位交替与 B-roll 辅助画面；直视镜头的交流感镜头是否达到约 70%；背景元素是否与讲述领域强相关（书架/证书/数据屏/作品墙）；面部主光是否均匀、无阴阳脸与眼镜反光；服装与背景是否有明度对比；付费导向内容是否按高半档执行。拒绝卧室床铺、杂乱居家背景、廉价背景元素（起皱背景布/塑料感假绿植/歪斜的书/空书壳）、光线事故（顶光眼袋/背后窗户过曝）、过度花哨的虚拟背景与抢戏元素。",
    "byTag": {
      "talking": "主口播中近景：胸部以上、构图稳定、背景不抢戏，人物最亮。",
      "person-close": "口播近景/特写：金句与结论处切入，眼神交流清楚、情绪克制有力。",
      "b-roll": "内容辅助画面：示意图/案例/屏幕演示与字幕卡，信息密度与口播节奏匹配。",
      "trust-detail": "信任状与环境细节：书架/证书/数据屏/设备，真实可信、与领域强相关。"
    }
  }
