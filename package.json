{
  "name": "workloom-ai-acquisition",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@workloom/audit-engine": "workspace:*",
    "@workloom/base": "workspace:*",
    "@workloom/db": "workspace:*",
    "@workloom/runtime": "workspace:*",
    "@workloom/shared": "workspace:*",
    "pg": "8.23.0",
    "yaml": "2.9.0"
  },
  "scripts": {
    "dev": "node scripts/dev-note.js && concurrently -k -n server,web \"pnpm -C apps/server dev\" \"pnpm -C apps/web dev\"",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env scripts/seed.ts && tsx --env-file=.env scripts/seed-geo.ts",
    "demo": "TOOL_UNVERIFIED_RATE=0 tsx --env-file=.env scripts/demo.ts",
    "doctor": "bash scripts/doctor.sh",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:scripts": "vitest run scripts/tools/video-request-regression.test.ts scripts/bundle-governance.test.ts scripts/suite-fixture-preflight.test.ts scripts/verify-client-foundation-extensions.test.ts scripts/geo-fusion-plan-doc-sync.test.ts bundles/ai-video/connectors/bgm-bridge/verify-message.test.ts bundles/ai-video/connectors/bgm-bridge/genre-mismatch.test.ts bundles/ai-video/connectors/bgm-bridge/recipes-expansion.test.ts bundles/ai-video/connectors/bgm-bridge/tonality-context.test.ts bundles/ai-video/connectors/color-bridge/core.test.ts bundles/ai-video/library/luts/luts.test.ts bundles/ai-video/connectors/subtitle-bridge/punctuation.test.ts bundles/ai-video/connectors/cine-kb-bridge/audit-round3.test.ts && node --test scripts/tools/film-voice-artifact.test.mjs",
    "db:verify-chain": "tsx --env-file=.env scripts/verify-chain.ts",
    "suite": "TOOL_UNVERIFIED_RATE=0 tsx --env-file=.env scripts/suite.ts",
    "db:seed:video": "tsx --env-file=.env scripts/seed-video.ts",
    "db:seed:geo": "tsx --env-file=.env scripts/seed-geo.ts",
    "onboarding": "tsx --env-file=.env scripts/onboarding.mts",
    "acceptance:onboarding": "tsx --env-file=.env scripts/acceptance/onboarding.mts",
    "scan:fences": "tsx scripts/tools/fence-alias-scan.mts",
    "metrics": "tsx --env-file=.env scripts/metrics.mts",
    "scan:knowhow": "tsx scripts/tools/knowhow-depth.mts",
    "c-layer": "tsx --env-file=.env scripts/c-layer/evaluate.mts",
    "acceptance:scale-s8": "tsx --env-file=.env scripts/acceptance/scale-s8.mts",
    "connectors:check": "tsx --env-file=.env scripts/connectors-check.mts",
    "suite:geo": "tsx --env-file=.env scripts/suite-geo.ts",
    "release:gate": "tsx --env-file=.env scripts/release-gate.ts",
    "suite:hotel": "tsx --env-file=.env scripts/suite-hotel.ts",
    "audit:scan": "tsx --env-file=.env scripts/audit-scan.ts",
    "agent:tour": "bash scripts/agent-tour.sh",
    "preview:all": "bash scripts/preview-all.sh",
    "capabilities": "node scripts/generate-capabilities.mjs",
    "capabilities:check": "node scripts/generate-capabilities.mjs --check",
    "acceptance:matrix": "tsx --env-file=.env scripts/acceptance-matrix.mts",
    "capabilities:pptx": "python3 scripts/build-capability-pptx.py",
    "postinstall": "pnpm -C packages/industry-contract build && (node scripts/postinstall-note.js || true)",
    "overview:pptx": "python3 scripts/build-overview-pptx.py",
    "oss:watch": "bash scripts/oss-watch.sh",
    "oss:plan": "bash scripts/oss-watch.sh --show",
    "db:seed:acq": "tsx --env-file=.env scripts/seed-acquisition.ts",
    "computer": "tsx packages/base/computer-use/cli.ts",
    "computer:preflight": "bash packages/base/computer-use/toolkit/preflight_check.sh",
    "computer:start": "bash packages/base/computer-use/toolkit/start_desktop.sh",
    "computer:stop": "bash packages/base/computer-use/toolkit/stop_desktop.sh",
    "computer:serve": "tsx packages/base/computer-use/serve.ts",
    "computer:mcp": "tsx packages/base/computer-use/mcp.ts",
    "computer:smoke": "tsx packages/base/computer-use/smoke.ts",
    "setup": "bash scripts/bootstrap.sh",
    "setup:full": "bash scripts/bootstrap.sh --with-computer",
    "skill:forge": "tsx scripts/skill-forge.mts",
    "app": "tsx scripts/desktop-app.mts",
    "app:dev": "tsx scripts/desktop-app.mts --dev",
    "app:pack": "electron-builder --dir",
    "app:dist": "electron-builder",
    "setup:lite": "tsx scripts/setup-lite.mts",
    "db:seed:aipm": "tsx --env-file=.env scripts/seed-aipm.ts",
    "product:verify": "node scripts/verify-product-content.mjs",
    "projections:generate": "tsx scripts/generate-client-projections.mts --write",
    "projections:check": "tsx scripts/generate-client-projections.mts",
    "bundle:governance": "tsx scripts/bundle-governance.mts",
    "bundle:release": "tsx scripts/bundle-governance.mts --refresh-digests --release",
    "desktop:release:contract": "node --test scripts/unsigned-desktop-release.test.mjs scripts/desktop-release-finalizer.test.mjs",
    "oss:inventory": "bash scripts/oss-watch.sh --inventory",
    "oss:check": "bash scripts/oss-watch.sh --check",
    "test:oss": "node --test scripts/oss-inventory.test.mjs",
    "talkcraft:install": "tsx scripts/tools/talkcraft-engine-install.mts",
    "talkcraft:check": "tsx scripts/tools/talkcraft-engine-install.mts --check",
    "explainer:run": "tsx scripts/tools/explainer-run.mts",
    "test:talkcraft": "vitest run apps/server/src/video/explainer/explainer.test.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "node-pty"
    ],
    "overrides": {
      "@workloom/ui@0.1.1": "https://cnb.cool/workloom-ai/workloom-im/-/releases/download/ui-v0.1.1/workloom-ui-0.1.1.tgz"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.1.0",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "typescript-governance": "npm:typescript@5.9.3",
    "vitest": "^4.1.11",
    "yaml": "2.9.0",
    "yaml-governance": "npm:yaml@2.9.0"
  },
  "description": "WorkLoom 获客系统 · 短视频社媒营销 × GEO × 获客五环 × 行业运营（首垂直：酒店）"
}
